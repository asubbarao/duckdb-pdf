# name: test/sql/zz_build_guard.test
# description: the suite is testing the build in this tree, not one from ~/.duckdb
# group: [sql]

require pdf

# Exported by the Makefile only when the build's DuckDB is the repo's pin;
# community CI parses the same Makefile but builds against its own DuckDB, so
# the guard skips there instead of failing on the version assertion below.
require-env PDF_LOCAL_BUILD_GUARD

require-env EXPECTED_EXT_VERSION

require-env PDF_DUCKDB_VERSION

query I
SELECT library_version = '${PDF_DUCKDB_VERSION}' AND starts_with(source_id, 'd54cbbe3df') FROM pragma_version();
----
true

query I
SELECT extension_version = '${EXPECTED_EXT_VERSION}'
FROM duckdb_extensions() WHERE extension_name = 'pdf';
----
true
