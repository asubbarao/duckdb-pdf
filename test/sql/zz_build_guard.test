# name: test/sql/zz_build_guard.test
# description: the suite is testing the build in this tree, not one from ~/.duckdb
# group: [sql]

require pdf

query I
SELECT library_version = 'v2.0.0' AND starts_with(source_id, 'd54cbbe3df') FROM pragma_version();
----
true

require-env EXPECTED_EXT_VERSION

query I
SELECT extension_version = '${EXPECTED_EXT_VERSION}'
FROM duckdb_extensions() WHERE extension_name = 'pdf';
----
true
