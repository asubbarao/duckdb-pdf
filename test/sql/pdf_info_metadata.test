# name: test/sql/pdf_info_metadata.test
# description: pdf_info function tests
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

# ── hello.pdf metadata ────────────────────────────────────────────────────

# Returns exactly 1 row for a 1-page file
query I
SELECT len(list(file)) FROM pdf_info('test/data/hello.pdf');
----
1

# pages column reports the true page count
query I
SELECT page_count FROM pdf_info('test/data/hello.pdf');
----
1

# not encrypted
query I
SELECT is_encrypted FROM pdf_info('test/data/hello.pdf');
----
false

# file column is populated
query I
SELECT ends_with(lower(file), 'hello.pdf') FROM pdf_info('test/data/hello.pdf');
----
true

# ── two_pages.pdf: pages = 2 ──────────────────────────────────────────────

query I
SELECT page_count FROM pdf_info('test/data/two_pages.pdf');
----
2

query I
SELECT is_encrypted FROM pdf_info('test/data/two_pages.pdf');
----
false

# ── table.pdf: pages = 1, not encrypted ──────────────────────────────────

query I
SELECT page_count FROM pdf_info('test/data/table.pdf');
----
1

query I
SELECT is_encrypted FROM pdf_info('test/data/table.pdf');
----
false

# ── scanned.pdf: pages = 1, not encrypted ────────────────────────────────

query I
SELECT page_count FROM pdf_info('test/data/scanned.pdf');
----
1

query I
SELECT is_encrypted FROM pdf_info('test/data/scanned.pdf');
----
false

# ── error: missing file ───────────────────────────────────────────────────

statement error
SELECT * FROM pdf_info('test/data/does_not_exist.pdf');
----
