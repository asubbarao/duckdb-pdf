# name: test/sql/torture_named_params.test
# description: named parameter validation and edge behavior on readers and svg (auto_ocr false)
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

# ── ocr_dpi extremes are range-validated (1–2400) even when OCR never fires ──

statement error
SELECT * FROM read_pdf('test/data/hello.pdf', ocr_dpi := 0, auto_ocr := false);
----
ocr_dpi must be between 1 and 2400

statement error
SELECT * FROM read_pdf('test/data/hello.pdf', ocr_dpi := 2401, auto_ocr := false);
----
ocr_dpi must be between 1 and 2400

# extreme low dpi with auto_ocr false still ok
statement ok
SELECT count(*) >= 0 FROM read_pdf('test/data/hello.pdf', ocr_dpi := 1, auto_ocr := false);

# ── first_page := 0 is rejected (must be >= 1) ──────────────────────────────

statement error
SELECT COUNT(*) = 1 FROM read_pdf('test/data/hello.pdf', first_page := 0, auto_ocr := false);
----
first_page must be >= 1

# ── first/last far beyond doc end → 0 rows (no error) ───────────────────────

query I
SELECT COUNT(*) = 0 FROM read_pdf('test/data/hello.pdf', first_page := 9999, last_page := 9999, auto_ocr := false);
----
true

# ── last < first is rejected ────────────────────────────────────────────────

statement error
SELECT COUNT(*) = 0 FROM read_pdf('test/data/two_pages.pdf', first_page := 2, last_page := 1, auto_ocr := false);
----
must be >= first_page

# ── last_page := 1 on 2pg doc ok ────────────────────────────────────────────

query I
SELECT COUNT(*) = 1 FROM read_pdf('test/data/two_pages.pdf', last_page := 1, auto_ocr := false);
----
true

# ── bogus layout is rejected, loudly, at bind time ──────────────────────────
#
# This used to fall through to 'reading' in silence, which meant layout := true
# (cast to the string 'true') and every typo quietly produced the wrong text on
# multi-column pages. The error names the alternatives because an agent holding
# only the binary has no other way to learn them.

statement error
SELECT COUNT(*) FROM read_pdf('test/data/hello.pdf', layout := 'bogus', auto_ocr := false);
----
layout must be one of ['auto', 'physical', 'reading', 'raw'], not 'bogus'

# A boolean casts to a string and must not be mistaken for "turn layout on".
statement error
SELECT COUNT(*) FROM read_pdf('test/data/hello.pdf', layout := true, auto_ocr := false);
----
layout must be one of ['auto', 'physical', 'reading', 'raw'], not 'true'

# Bind-time, so a bad layout is caught even when the file cannot be opened.
statement error
SELECT COUNT(*) FROM read_pdf('test/data/does_not_exist.pdf', layout := 'bogus');
----
layout must be one of ['auto', 'physical', 'reading', 'raw'], not 'bogus'

statement error
SELECT contains( pdf_to_text('test/data/hello.pdf', 'bogus'), 'Hello' );
----
layout must be one of ['auto', 'physical', 'reading', 'raw'], not 'bogus'

# Readers that work off word geometry never used layout; they no longer offer it.
statement error
SELECT COUNT(*) FROM read_pdf_words('test/data/hello.pdf', layout := 'physical');
----
Invalid named parameter "layout"

# ── pdf_to_svg page edges: pages are 1-based and range-checked ──────────────

statement error
SELECT length(pdf_to_svg('test/data/hello.pdf', 0)) > 0;
----
out of range

statement error
SELECT pdf_to_svg('test/data/hello.pdf', 99999);
----
out of range

statement error
SELECT pdf_to_svg('test/data/hello.pdf', 2);
----
out of range

# first_page last_page also on words/lines
query I
SELECT COUNT(*) = 0 FROM read_pdf_lines('test/data/two_pages.pdf', first_page := 99, last_page := 100, auto_ocr := false);
----
true

query I
SELECT COUNT(*) > 0 FROM read_pdf_words('test/data/two_pages.pdf', last_page := 1, auto_ocr := false);
----
true
