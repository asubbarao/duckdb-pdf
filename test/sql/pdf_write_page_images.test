# name: test/sql/pdf_write_page_images.test
# description: pdf_write_page_images writes page preview PNGs to out_dir/<stem>/p{N}.png
# group: [sql]

require pdf

# ── multi-page fixture → Closure path convention + non-empty rows ────────────
# two_pages.pdf has 2 pages; low dpi for speed

# Path checks use ends_with on the filename only (portable across / and \).
query IIII
SELECT page,
       ends_with(out_path, 'p' || page || '.png') AND contains(out_path, 'two_pages'),
       width > 0 AND height > 0,
       bytes > 100
FROM pdf_write_page_images('test/data/two_pages.pdf', '__TEST_DIR__/pages', dpi := 72)
ORDER BY page;
----
1	true	true	true
2	true	true	true

# files on disk: PNG magic 89 50 4E 47
query I
SELECT starts_with(hex(content), '89504E47')
FROM read_blob('__TEST_DIR__/pages/two_pages/p1.png');
----
true

query I
SELECT starts_with(hex(content), '89504E47') AND octet_length(content) > 100
FROM read_blob('__TEST_DIR__/pages/two_pages/p2.png');
----
true

# no zero-pad (p1.png / p2.png, not p01 / p-001)
query I
SELECT bool_and(ends_with(out_path, 'p' || page || '.png'))
FROM pdf_write_page_images('test/data/two_pages.pdf', '__TEST_DIR__/pages_nopad', dpi := 50);
----
true

# ── first_page / last_page range ─────────────────────────────────────────────

query I
SELECT list(page ORDER BY page)
FROM pdf_write_page_images('test/data/two_pages.pdf', '__TEST_DIR__/pages_range',
                           dpi := 50, first_page := 2, last_page := 2);
----
[2]

query I
SELECT starts_with(hex(content), '89504E47')
FROM read_blob('__TEST_DIR__/pages_range/two_pages/p2.png');
----
true

# ── single-page stem directory ───────────────────────────────────────────────

query I
SELECT ends_with(out_path, 'p1.png') AND contains(out_path, 'hello') AND bytes > 100
FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/pages_hello', dpi := 72);
----
true

# ── dpi validation ───────────────────────────────────────────────────────────

statement error
SELECT * FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/bad_dpi', dpi := 0);
----
dpi must be between

statement error
SELECT * FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/bad_dpi', dpi := 2401);
----
dpi must be between

# ── empty out_dir rejected ───────────────────────────────────────────────────

statement error
SELECT * FROM pdf_write_page_images('test/data/hello.pdf', '');
----
out_dir must not be empty

# ── overwrite is silent (second write succeeds, still valid PNG) ─────────────

query I
SELECT ends_with(out_path, 'p1.png') AND contains(out_path, 'hello') AND bytes > 100
FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/pages_hello', dpi := 72);
----
true

query I
SELECT starts_with(hex(content), '89504E47') AND octet_length(content) > 100
FROM read_blob('__TEST_DIR__/pages_hello/hello/p1.png');
----
true

# ── missing input ──────────────────────────────────────────────────────────
# Substring shared by Linux ("No such file or directory") and Windows
# ("The system cannot find the file specified.").
statement error
SELECT * FROM pdf_write_page_images('test/data/does_not_exist.pdf', '__TEST_DIR__/w');
----
Cannot open file

# ── multi-file glob ────────────────────────────────────────────────────────
query I
SELECT count(*) FROM pdf_write_page_images(['test/data/hello.pdf', 'test/data/two_pages.pdf'],
                                           '__TEST_DIR__/multi', dpi := 50);
----
3

# read_blob accepts globs; no lateral column-ref (TVF literal-only wall).
query I
SELECT bool_and(starts_with(hex(content), '89504E47')) AND count(*) = 3
FROM read_blob('__TEST_DIR__/multi/**/*.png');
----
true

# ── stem collision preflight: no silent overwrite of out_dir/<stem>/ ───────
# Repeated list entries share a stem. Reject before creating out_dir.

statement error
SELECT * FROM pdf_write_page_images(['test/data/hello.pdf', 'test/data/hello.pdf'],
                                    '__TEST_DIR__/repeat_out', dpi := 50);
----
output collision

query I
SELECT count(*) FROM glob('__TEST_DIR__/repeat_out/**');
----
0

# Distinct directories, same basename/stem. mkdir via a successful write first
# (HPDF_SaveToFile does not create parent dirs).

query I
SELECT count(*) FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/col_a', dpi := 50);
----
1

query I
SELECT count(*) FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/col_b', dpi := 50);
----
1

statement ok
COPY (SELECT 'left collision fixture' AS t) TO '__TEST_DIR__/col_a/dup.pdf' (FORMAT pdf);

statement ok
COPY (SELECT 'right collision fixture' AS t) TO '__TEST_DIR__/col_b/dup.pdf' (FORMAT pdf);

statement error
SELECT * FROM pdf_write_page_images(['__TEST_DIR__/col_a/dup.pdf', '__TEST_DIR__/col_b/dup.pdf'],
                                    '__TEST_DIR__/same_stem_out', dpi := 50);
----
output collision

query I
SELECT count(*) FROM glob('__TEST_DIR__/same_stem_out/**');
----
0

# Case-insensitive stem key (Windows / case-insensitive volumes): Hello vs hello.

query I
SELECT count(*) FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/case_a', dpi := 50);
----
1

query I
SELECT count(*) FROM pdf_write_page_images('test/data/hello.pdf', '__TEST_DIR__/case_b', dpi := 50);
----
1

statement ok
COPY (SELECT 'CaseA fixture' AS t) TO '__TEST_DIR__/case_a/Hello.pdf' (FORMAT pdf);

statement ok
COPY (SELECT 'CaseB fixture' AS t) TO '__TEST_DIR__/case_b/hello.pdf' (FORMAT pdf);

statement error
SELECT * FROM pdf_write_page_images(['__TEST_DIR__/case_a/Hello.pdf', '__TEST_DIR__/case_b/hello.pdf'],
                                    '__TEST_DIR__/case_out', dpi := 50);
----
output collision

query I
SELECT count(*) FROM glob('__TEST_DIR__/case_out/**');
----
0

# Ordinary valid export: distinct stems keep the existing out_dir/<stem>/pN.png layout.

query I
SELECT count(*) FROM pdf_write_page_images(['test/data/hello.pdf', 'test/data/two_pages.pdf'],
                                           '__TEST_DIR__/valid_stems', dpi := 50);
----
3

query I
SELECT bool_and(starts_with(hex(content), '89504E47')) AND count(*) = 3
FROM read_blob('__TEST_DIR__/valid_stems/**/*.png');
----
true

# ── reserved stems '.' / '..' must not escape out_dir/<stem>/ ──────────────
# PdfOpsStem('...pdf') → '..'  → would write out_dir/../pN.png
# PdfOpsStem('..pdf')  → '.'   → would write out_dir/./pN.png (out_dir root)

statement ok
COPY (SELECT 'dotdot stem fixture' AS t) TO '__TEST_DIR__/...pdf' (FORMAT pdf);

statement error
SELECT * FROM pdf_write_page_images('__TEST_DIR__/...pdf', '__TEST_DIR__/escape_out', dpi := 50);
----
refusing output stem

query I
SELECT count(*) FROM glob('__TEST_DIR__/escape_out/**');
----
0

query I
SELECT count(*) FROM glob('__TEST_DIR__/p1.png');
----
0

statement ok
COPY (SELECT 'dot stem fixture' AS t) TO '__TEST_DIR__/..pdf' (FORMAT pdf);

statement error
SELECT * FROM pdf_write_page_images('__TEST_DIR__/..pdf', '__TEST_DIR__/escape_dot', dpi := 50);
----
refusing output stem

query I
SELECT count(*) FROM glob('__TEST_DIR__/escape_dot/**');
----
0

# A stem that merely contains dots (not exactly '.' / '..') stays valid.
statement ok
COPY (SELECT 'safe dotted stem' AS t) TO '__TEST_DIR__/foo...pdf' (FORMAT pdf);

query I
SELECT ends_with(out_path, 'p1.png') AND contains(out_path, 'foo..') AND bytes > 100
FROM pdf_write_page_images('__TEST_DIR__/foo...pdf', '__TEST_DIR__/dotted_ok', dpi := 50);
----
true
