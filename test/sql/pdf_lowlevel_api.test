# name: test/sql/pdf_lowlevel_api.test
# description: Low-level: poppler_version, pdf_to_png, tesseract_ocr, ocr_image
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

# ── poppler_version() ───────────────────────────────────────────────────────

query I
SELECT poppler_version() IS NOT NULL;
----
true

query I
SELECT length(poppler_version()) > 0;
----
true

# ── pdf_to_png(blob, page, dpi) ────────────────────────────────────

query I
SELECT octet_length(pdf_render((SELECT content FROM read_blob('test/data/hello.pdf')), 1, {dpi: 72})) > 100;
----
true

query I
SELECT pdf_render((SELECT content FROM read_blob('test/data/hello.pdf')), 1, {dpi: 72})[1:4] = '\x89PNG'::BLOB;
----
true

# page out of range (1-based, same style as pdf_to_png)
statement error
SELECT pdf_render((SELECT content FROM read_blob('test/data/hello.pdf')), 0, {dpi: 72});
----
out of range

statement error
SELECT pdf_render((SELECT content FROM read_blob('test/data/hello.pdf')), 99, {dpi: 72});
----
out of range

statement error
SELECT pdf_render((SELECT content FROM read_blob('test/data/hello.pdf')), 1, {dpi: 0});
----
dpi must be between

# ── Scalar OCR on rendered page ────────────────────────────────────────────
# Render a scanned page then OCR the PNG BLOB. Bundled eng model must work.

statement ok
SET VARIABLE ocr_png = (SELECT pdf_render(content, 1, {dpi: 150}) FROM read_blob('test/data/scanned.pdf'));

query I
SELECT length(ocr_image(pdf_render(content, 1, {dpi: 150}))) > 0 FROM read_blob('test/data/scanned.pdf');
----
true

# lang + psm overloads bind
query I
SELECT length(ocr_image(getvariable('ocr_png'), {language: 'eng'})) > 0;
----
true

query I
SELECT length(ocr_image(getvariable('ocr_png'), {language: 'eng', psm: 3})) > 0;
----
true

# richer positional overloads: oem + tessdata_dir + preprocess + vars MAP
query I
SELECT length(ocr_image(getvariable('ocr_png'), {language: 'eng', psm: 3, oem: 3, tessdata_dir: '', preprocess: true, vars: MAP {'tessedit_char_whitelist': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,;:''"!?-'}})) > 0;
----
true

# full arity including empty config path
query I
SELECT length(ocr_image(getvariable('ocr_png'), {language: 'eng', psm: 3, oem: 3, tessdata_dir: '', preprocess: true, vars: MAP {}, config: ''})) > 0;
----
true

# bad psm / oem fail fast
statement error
SELECT ocr_image(getvariable('ocr_png'), {language: 'eng', psm: 99});
----
psm must be between

statement error
SELECT ocr_image(getvariable('ocr_png'), {language: 'eng', psm: 3, oem: 9});
----
oem must be between

# garbage image BLOB fails
statement error
SELECT ocr_image('\x00\x01\x02\x03'::BLOB);
----
could not decode image BLOB

# A column of distinct PDF pages remains row-wise: the scalar OCR takes the
# rendered image in each row. NULL image and NULL option fields propagate.
query I
WITH images AS (
  SELECT pdf_render(content, 1, {dpi: 150}) AS image FROM read_blob('test/data/scanned.pdf')
  UNION ALL
  SELECT pdf_render(content, 1, {dpi: 150}) AS image FROM read_blob('test/data/hello.pdf')
), recognised AS (SELECT ocr_image(image) AS text FROM images)
SELECT count(*) = 2 AND count(DISTINCT text) = 2 AND bool_and(length(text) > 0) FROM recognised;
----
true

query I
SELECT ocr_image(NULL::BLOB) IS NULL
   AND ocr_image(getvariable('ocr_png'), {psm: NULL}) = ocr_image(getvariable('ocr_png'));
----
true

query I
SELECT contains(ocr_image(getvariable('ocr_png'), {format: 'hocr'}), 'ocr_');
----
true

# ── ocr_image TVF: named params + format text|hocr|tsv ─────────────────────
# TVF args must be foldable (no subqueries); use the stored PNG above.

statement ok
SET VARIABLE ocr_png = (
  SELECT pdf_render(content, 1, {dpi: 150}) FROM read_blob('test/data/scanned.pdf')
);

query III
SELECT length(text) > 0, confidence BETWEEN 0 AND 100, format
FROM ocr_image(getvariable('ocr_png'), language := 'eng', psm := 3, format := 'text');
----
true	true	text

query II
SELECT length(text) > 20, format
FROM ocr_image(getvariable('ocr_png'), format := 'hocr');
----
true	hocr

query II
SELECT length(text) > 0, format
FROM ocr_image(getvariable('ocr_png'), format := 'tsv',
  vars := MAP {'tessedit_char_whitelist': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,;:''"!?-'});
----
true	tsv

statement error
SELECT * FROM ocr_image(getvariable('ocr_png'), format := 'not_a_format');
----
ocr format must be

# NULL named params keep defaults (must not INTERNAL Error)
query II
SELECT length(text) > 0, format
FROM ocr_image(getvariable('ocr_png'), language := NULL, psm := NULL, format := NULL, vars := NULL);
----
true	text

statement error
SELECT * FROM ocr_image(NULL);
----
must not be NULL

statement error
SELECT * FROM ocr_image(''::BLOB);
----
empty image BLOB

statement error
SELECT * FROM ocr_image('\x00\x01\x02'::BLOB);
----
could not decode image BLOB

# read_pdf exposes ocr_confidence when OCR runs
query II
SELECT used_ocr, ocr_confidence IS NOT NULL AND ocr_confidence BETWEEN 0 AND 100
FROM read_pdf('test/data/scanned.pdf', ocr := true)
LIMIT 1;
----
true	true

query I
SELECT ocr_confidence IS NULL
FROM read_pdf('test/data/hello.pdf', auto_ocr := false)
LIMIT 1;
----
true

# missing file still errors (pre-existing path); confidence column present when readable
statement error
SELECT * FROM read_pdf('/no/such/file.pdf', auto_ocr := false);
----
Cannot open file
