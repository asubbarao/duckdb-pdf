# name: test/sql/read_pdf_columns.test
# description: multi-column pages read correctly with no parameters (layout := 'auto')
# group: [sql]

require pdf

# httpfs is out of tree in DuckDB 1.5, so the test binary only has it when the
# runner is allowed to autoload. The repo Makefile exports
# DUCKDB_TEST_AUTOLOADING=all for exactly that reason; running this file by hand:
#
#   DUCKDB_TEST_AUTOLOADING=all PDF_NETWORK_TESTS=1 \
#     ./build/release/test/unittest test/sql/read_pdf_columns.test
require httpfs

# Network test. Opt in with PDF_NETWORK_TESTS=1 so an offline `make test` and a
# CI runner without egress both stay green.
require-env PDF_NETWORK_TESTS

statement ok
PRAGMA enable_verification

# Two published documents, no fixtures:
#
#   "One Size Fits All" (ICDE 2015) — a real two-column academic paper, PDF 1.3
#   out of Acrobat Distiller 5. Its body pages are two text columns with a
#   gutter; its title page and its figure pages are one.
#
#   The DuckDB Friendly SQL Calendar 2026 — the document the layout engine was
#   built for. Every month page pairs a prose column on the left with a seven-
#   wide calendar grid on the right, and the grid's first row starts under
#   whichever weekday the 1st falls on. A reader that discards horizontal
#   position produces '1 2 3 4 5 6 7' for every month — the exact bug this
#   guards. The content is frozen, but the URL is year-scoped merch (the 2025
#   and 2024 URLs already 404), so the URL is the part that rots.

# ── the default takes the geometry path ─────────────────────────────────────

# The weekday header survives as one line, in order.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE text = 'MON TUE WED THU FRI SAT SUN';
----
true

# 1 January 2026 is a Thursday, so the first row holds exactly four dates. The
# short row stays short: alignment is carried by position, so the test that
# matters is that nothing was invented to fill the leading cells.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE text = '1 2 3 4';
----
true

# A full row is whole.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE text = '5 6 7 8 9 10 11';
----
true

# Prose lines are whole too, and never fused with a grid row that shares their
# vertical band.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE text = 'Prefix aliases allow you to formulate queries by first specifying the alias';
----
true

# read_pdf agrees with read_pdf_lines: one engine, not two.
query I
SELECT contains(text, chr(10) || 'MON TUE WED THU FRI SAT SUN' || chr(10))
FROM read_pdf('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
              first_page := 2, last_page := 2);
----
true

# Every prose line precedes every grid line: columns are emitted left to right,
# not interleaved by y.
query I
SELECT max(line) FILTER (NOT grid) < min(line) FILTER (grid) FROM (
  SELECT line, text LIKE 'MON%' OR left(text, 1) BETWEEN '0' AND '9' AS grid
  FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                      first_page := 2, last_page := 2)
);
----
true

# The same fact on prose, where it is stronger: on a body page of the paper the
# whole left column is emitted before the first line of the right column,
# instead of the two being zipped together by y.
query I
SELECT max(line) FILTER (column_index = 0) < min(line) FILTER (column_index = 1)
FROM read_pdf_words('https://blobs.duckdb.org/papers/stonebraker-centintemel-one-size-fits-all-icde-2015.pdf',
                    first_page := 4, last_page := 4);
----
true

# A body page's first line is the continuation of the previous page's left
# column, not a splice of the two columns' first lines.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/papers/stonebraker-centintemel-one-size-fits-all-icde-2015.pdf',
                    first_page := 4, last_page := 4)
WHERE text = 'deliver such feeds. Financial institutions have a variety of';
----
true

# ── the grid is ONE column, not seven ───────────────────────────────────────

# The gaps between weekday columns are wider than any sane minimum gutter, so
# width alone cannot reject them. They are rejected because the columns they
# would create are a few percent of the page wide. If that guard regresses the
# grid rows shatter into single tokens and the line count jumps.
query I
SELECT COUNT(*) = 20
FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2);
----
true

# ── the escape hatches still reach poppler ──────────────────────────────────

query I
SELECT contains(pdf_to_text('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf', 'physical'), 'MON');
----
true

query I
SELECT contains(pdf_to_text('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf', 'raw'), 'MON');
----
true

query I
SELECT contains(pdf_to_text('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf', 'reading'), 'MON');
----
true

# ── single-column pages are left alone ──────────────────────────────────────

# The paper's title page runs a full-width title over its two columns, and the
# figure page reports one band; a page with too little text to judge is never
# split.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('https://blobs.duckdb.org/papers/stonebraker-centintemel-one-size-fits-all-icde-2015.pdf',
                    first_page := 1, last_page := 1)
WHERE text = '“One Size Fits All”: An Idea Whose Time Has Come and Gone';
----
true

# ── column_index is the band, and it is queryable ───────────────────────────

# Two columns on the paper's body pages, numbered left to right; the figure
# page between them has one.
query II
SELECT page, list(DISTINCT column_index ORDER BY column_index) AS bands
FROM read_pdf_words('https://blobs.duckdb.org/papers/stonebraker-centintemel-one-size-fits-all-icde-2015.pdf',
                    first_page := 3, last_page := 5)
GROUP BY page ORDER BY page;
----
3	[0]
4	[0, 1]
5	[0, 1]

# On the calendar, prose is column 0 and the grid is column 1.
query I
SELECT list(DISTINCT column_index) = [0]
FROM read_pdf_words('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE word = 'JANUARY';
----
true

query I
SELECT list(DISTINCT column_index) = [1]
FROM read_pdf_words('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2)
WHERE word IN ('MON', 'SUN');
----
true

# Reconstructing which weekday a date sits under is a join on x, and it is the
# reason the geometry is exposed rather than only the text.
query II
SELECT h.word AS weekday, list(d.word ORDER BY d.y0) AS dates
FROM read_pdf_words('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2) h
JOIN read_pdf_words('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                    first_page := 2, last_page := 2) d
  ON d.column_index = 1 AND abs((d.x0 + d.x1) / 2 - (h.x0 + h.x1) / 2) < 7
WHERE h.word = 'THU' AND d.word <> 'THU'
GROUP BY h.word;
----
THU	[1, 8, 15, 22, 29]

# Every month's first row is short in exactly the way its weekday demands. This
# is the assertion that caught the original bug, across all twelve month pages.
query I
SELECT COUNT(*) = 12 FROM (
  SELECT page
  FROM read_pdf_lines('https://blobs.duckdb.org/merch/duckdb-friendly-sql-calendar-2026.pdf',
                      first_page := 2, last_page := 13)
  WHERE text = 'MON TUE WED THU FRI SAT SUN'
);
----
true
