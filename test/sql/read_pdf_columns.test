# name: test/sql/read_pdf_columns.test
# description: multi-column pages read correctly with no parameters (layout := 'auto')
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

# two_column.pdf is a one-page A4 laid out like the DuckDB Friendly SQL
# Calendar: prose at x 40..280, a seven-column grid at x 330..548, a 50pt
# corridor between them. See test/data/gen_two_column.py.
#
# The grid's first row starts under THU, so a reader that discards horizontal
# position produces "01 02 03 04 05 06 07" — the exact shape of the bug this
# guards, where every month of the calendar appeared to start on a Monday.

# ── the default takes the geometry path ─────────────────────────────────────

# The weekday header survives as one line, in order.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('test/data/two_column.pdf')
WHERE text = 'MON TUE WED THU FRI SAT SUN';
----
true

# The short first row stays short: four cells, not seven. Column alignment is
# carried by position, so the test that matters is that nothing was invented.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('test/data/two_column.pdf')
WHERE text = '01 02 03 04';
----
true

# A full row is whole.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('test/data/two_column.pdf')
WHERE text = '05 06 07 08 09 10 11';
----
true

# Prose lines are whole too, and never fused with a grid row that shares their
# vertical band — the first prose line and the weekday header sit at the same y.
query I
SELECT COUNT(*) = 1
FROM read_pdf_lines('test/data/two_column.pdf')
WHERE text = 'Prefix aliases let you name an expression before you write it.';
----
true

# read_pdf agrees with read_pdf_lines: one engine, not two.
query I
SELECT contains(text, chr(10) || 'MON TUE WED THU FRI SAT SUN' || chr(10))
FROM read_pdf('test/data/two_column.pdf');
----
true

# Every prose line precedes every grid line: columns are emitted left to right,
# not interleaved by y.
query I
SELECT max(CASE WHEN text LIKE 'MON%' OR text LIKE '0%' OR text LIKE '1%' THEN 0 ELSE line END)
     < min(CASE WHEN text LIKE 'MON%' OR text LIKE '0%' OR text LIKE '1%' THEN line ELSE 9999 END)
FROM read_pdf_lines('test/data/two_column.pdf');
----
true

# ── the grid is ONE column, not seven ───────────────────────────────────────

# The ~23pt gaps between weekday columns are wider than any sane minimum gutter,
# so width alone cannot reject them. They are rejected because the columns they
# would create are 4% of the page wide. If that guard regresses, the grid rows
# shatter into single tokens and the line count jumps.
query I
SELECT COUNT(*) = 8 FROM read_pdf_lines('test/data/two_column.pdf');
----
true

# ── the escape hatches still reach poppler ──────────────────────────────────

query I
SELECT contains(pdf_to_text('test/data/two_column.pdf', 'physical'), 'MON');
----
true

query I
SELECT contains(pdf_to_text('test/data/two_column.pdf', 'raw'), 'MON');
----
true

query I
SELECT contains(pdf_to_text('test/data/two_column.pdf', 'reading'), 'MON');
----
true

# ── single-column pages are left alone ──────────────────────────────────────

query I
SELECT contains(text, 'Hello') FROM read_pdf('test/data/hello.pdf', auto_ocr := false);
----
true

# A page with too little text to judge is never split.
query I
SELECT COUNT(*) > 0 FROM read_pdf_lines('test/data/hello.pdf');
----
true

# ── column_index is the band, and it is queryable ───────────────────────────

# Two columns on this page, numbered left to right.
query I
SELECT list(DISTINCT column_index ORDER BY column_index) = [0, 1]
FROM read_pdf_words('test/data/two_column.pdf');
----
true

# Prose is column 0, the grid is column 1.
query I
SELECT list(DISTINCT column_index) = [0]
FROM read_pdf_words('test/data/two_column.pdf') WHERE word = 'Prefix';
----
true

query I
SELECT list(DISTINCT column_index) = [1]
FROM read_pdf_words('test/data/two_column.pdf') WHERE word IN ('MON', 'SUN');
----
true

# Reconstructing which weekday a date sits under is a join on x, and it is the
# reason the geometry is exposed rather than only the text.
query II
SELECT h.word AS weekday, list(d.word ORDER BY d.y0) AS dates
FROM read_pdf_words('test/data/two_column.pdf') h
JOIN read_pdf_words('test/data/two_column.pdf') d
  ON d.column_index = 1 AND abs((d.x0 + d.x1) / 2 - (h.x0 + h.x1) / 2) < 7
WHERE h.word = 'THU' AND d.word <> 'THU'
GROUP BY h.word;
----
THU	[01, 08, 15]

# A single-column page reports one band.
query I
SELECT list(DISTINCT column_index) = [0] FROM read_pdf_words('test/data/hello.pdf');
----
true
