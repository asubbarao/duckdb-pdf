# name: test/sql/pdf_ocr_vision.test
# description: Apple Vision OCR backend (macOS); the Makefile sets PDF_VISION_TESTS on Darwin
# group: [sql]

require pdf

require-env PDF_VISION_TESTS

statement ok
PRAGMA enable_verification

# Page text from an image-only PDF.
query III
SELECT used_ocr, contains(lower(text), 'apple'), contains(lower(text), 'cherr')
FROM read_pdf('test/data/scanned.pdf', ocr := true, ocr_backend := 'vision');
----
true	true	true

# Word boxes carry OCR provenance, a 0..100 confidence and positive extents.
query IIII
SELECT count(*) > 0, bool_and(source = 'ocr'), bool_and(confidence BETWEEN 0 AND 100),
       bool_and(x1 > x0 AND y1 > y0 AND x0 >= 0 AND y0 >= 0)
FROM read_pdf_words('test/data/scanned.pdf', ocr := true, ocr_backend := 'vision');
----
true	true	true	true

# Vision and Tesseract place the words they both read in the same spot, in the
# same top-down coordinates.
query I
WITH vision AS (
  SELECT lower(word) AS word, x0, y0 FROM read_pdf_words('test/data/scanned.pdf', ocr := true, ocr_backend := 'vision')
), tesseract AS (
  SELECT lower(word) AS word, x0, y0 FROM read_pdf_words('test/data/scanned.pdf', ocr := true, ocr_retry := false)
)
SELECT count(*) >= 6 AND bool_and(abs(vision.x0 - tesseract.x0) < 6 AND abs(vision.y0 - tesseract.y0) < 6)
FROM vision JOIN tesseract USING (word);
----
true

# Rotated, cropped pages share the frame Tesseract uses. The two engines read
# the digits differently (Tesseract: SECRET90/65), so match on the word's prefix.
query I
WITH vision AS (
  SELECT word, x0, y0, x1, y1 FROM read_pdf_words('test/data/ocr_cropped_90.pdf', ocr := true, ocr_backend := 'vision')
  WHERE starts_with(upper(word), 'SECRET')
), tesseract AS (
  SELECT word, x0, y0, x1, y1 FROM read_pdf_words('test/data/ocr_cropped_90.pdf', ocr := true, ocr_retry := false)
  WHERE starts_with(upper(word), 'SECRET')
)
SELECT count(*) = 1 AND bool_and(abs(vision.x0 - tesseract.x0) < 5 AND abs(vision.y0 - tesseract.y0) < 5
                             AND abs(vision.x1 - tesseract.x1) < 5 AND abs(vision.y1 - tesseract.y1) < 5)
FROM vision CROSS JOIN tesseract;
----
true

# Image BLOBs, through the scalar and the table function.
query I
SELECT contains(lower(ocr_image(pdf_render(content, 1, {dpi: 300}), {backend: 'vision'})), 'apple')
FROM read_blob('test/data/scanned.pdf');
----
true

query III
SELECT contains(lower(text), 'apple'), confidence BETWEEN 0 AND 100, format
FROM ocr_image(pdf_render('test/data/scanned.pdf', 1, {dpi: 300}), backend := 'vision');
----
true	true	text

# Tesseract language codes map to Vision languages; '+' selects several.
query I
SELECT contains(lower(text), 'apple')
FROM read_pdf('test/data/scanned.pdf', ocr := true, ocr_backend := 'vision', ocr_language := 'eng+fra');
----
true

statement error
SELECT * FROM read_pdf('test/data/scanned.pdf', ocr := true, ocr_backend := 'vision', ocr_language := 'xx_unknown');
----
is not supported by Vision

# hocr and tsv are Tesseract output formats.
statement error
SELECT ocr_image(pdf_render(content, 1, {dpi: 300}), {backend: 'vision', format: 'hocr'}) FROM read_blob('test/data/scanned.pdf');
----
format must be 'text'

statement error
SELECT ocr_image('not an image'::BLOB, {backend: 'vision'});
----
could not decode image BLOB

# The searchable-PDF writer is Tesseract's renderer.
statement error
SELECT * FROM pdf_ocr('test/data/scanned.pdf', '{TEST_DIR}/vision.pdf', ocr_backend := 'vision');
----
requires ocr_backend := 'tesseract'
