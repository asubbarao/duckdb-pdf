# name: test/sql/torture_malformed.test
# description: adversarial malformed / corrupt / bad-path inputs to all readers and scalars
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

# ── runtime zero-byte fixture ───────────────────────────────────────────────

statement ok
COPY (SELECT 1 WHERE false) TO '__TEST_DIR__/zero.pdf' (FORMAT csv, HEADER false);

# ── zero-byte on all readers ────────────────────────────────────────────────

statement error
SELECT * FROM read_pdf('__TEST_DIR__/zero.pdf');
----
could not open

statement error
SELECT * FROM read_pdf('__TEST_DIR__/zero.pdf', grain := 'line');
----
could not open

statement error
SELECT * FROM read_pdf_words('__TEST_DIR__/zero.pdf');
----
could not open

statement error
SELECT * FROM read_pdf('__TEST_DIR__/zero.pdf', grain := 'table');
----
could not open

# ── zero-byte on scalars ────────────────────────────────────────────────────

statement error
SELECT pdf_text('__TEST_DIR__/zero.pdf');
----
could not open

statement error
SELECT pdf_text('__TEST_DIR__/zero.pdf', {format: 'html'});
----
could not open

statement error
SELECT pdf_text('__TEST_DIR__/zero.pdf', {format: 'xml'});
----
could not open

statement error
SELECT decode(pdf_render('__TEST_DIR__/zero.pdf', 1, {format: 'svg'}));
----
could not open

# ── text file renamed .pdf (committed fixture) ──────────────────────────────
#
# The three committed fixtures below stay synthetic on purpose: no published
# document is a broken one. A file that is not a PDF, a PDF cut off mid-xref,
# and bytes that only start with %PDF- are what the reader must refuse, and
# nobody publishes those on purpose.

statement error
SELECT * FROM read_pdf('test/data/text_as_pdf.pdf');
----
could not open

statement error
SELECT * FROM read_pdf('test/data/text_as_pdf.pdf', grain := 'line');
----
could not open

statement error
SELECT count(*) FROM read_pdf_words('test/data/text_as_pdf.pdf');
----
could not open

statement error
SELECT * FROM read_pdf('test/data/text_as_pdf.pdf', grain := 'table');
----
could not open

statement error
SELECT pdf_text('test/data/text_as_pdf.pdf');
----
could not open

statement error
SELECT pdf_text('test/data/text_as_pdf.pdf', {format: 'html'});
----
could not open

statement error
SELECT pdf_text('test/data/text_as_pdf.pdf', {format: 'xml'});
----
could not open

statement error
SELECT decode(pdf_render('test/data/text_as_pdf.pdf', 1, {format: 'svg'}));
----
could not open

