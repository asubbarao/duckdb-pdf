# name: test/sql/read_pdf_labels.test
# description: printed page labels on PDF readers
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

query II
SELECT page, label FROM read_pdf('test/data/page_labels.pdf') ORDER BY page;
----
1	i
2	ii
3	1
4	2

query II
SELECT page, label FROM read_pdf_lines('test/data/page_labels.pdf')
GROUP BY page, label ORDER BY page;
----
1	i
2	ii
3	1
4	2

query II
SELECT page, label FROM read_pdf_words('test/data/page_labels.pdf')
GROUP BY page, label ORDER BY page;
----
1	i
2	ii
3	1
4	2

query I
SELECT count(*) = 0
FROM (SELECT DISTINCT page, label FROM read_pdf('test/data/page_labels.pdf')) r
JOIN pdf_pages_info('test/data/page_labels.pdf') p USING (page)
WHERE r.label IS DISTINCT FROM nullif(p.label, '');
----
true

query I
SELECT count(*) = 0
FROM (SELECT DISTINCT page, label FROM read_pdf_lines('test/data/page_labels.pdf')) r
JOIN pdf_pages_info('test/data/page_labels.pdf') p USING (page)
WHERE r.label IS DISTINCT FROM nullif(p.label, '');
----
true

query I
SELECT count(*) = 0
FROM (SELECT DISTINCT page, label FROM read_pdf_words('test/data/page_labels.pdf')) r
JOIN pdf_pages_info('test/data/page_labels.pdf') p USING (page)
WHERE r.label IS DISTINCT FROM nullif(p.label, '');
----
true

query I
SELECT count(*) > 0 AND bool_and(label IS NULL)
FROM read_pdf('test/data/hello.pdf');
----
true

query I
SELECT count(*) > 0 AND bool_and(label IS NULL)
FROM read_pdf_lines('test/data/hello.pdf');
----
true

query I
SELECT count(*) > 0 AND bool_and(label IS NULL)
FROM read_pdf_words('test/data/hello.pdf');
----
true
