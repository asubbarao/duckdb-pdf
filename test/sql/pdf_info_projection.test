# name: test/sql/pdf_info_projection.test
# description: every consolidated pdf_info column projects correctly
# group: [sql]

require pdf

statement ok
PRAGMA enable_verification

statement ok
COPY (SELECT 'Document metadata projection' AS text) TO '__TEST_DIR__/projection_metadata.pdf'
(FORMAT pdf, TITLE 'Projection title', AUTHOR 'Projection author');

# Materialize full rows before checking one-column projections. The fixtures
# exercise populated metadata, PDF/A, form fields, IDs and mixed permissions.
statement ok
CREATE TABLE info_reference AS
SELECT * FROM pdf_info('test/data/restricted_permissions.pdf', password := 'reader')
UNION ALL SELECT * FROM pdf_info('test/data/pdfa.pdf')
UNION ALL SELECT * FROM pdf_info('__TEST_DIR__/projection_metadata.pdf');

query IIIIIIIIIIT
SELECT is_encrypted, perm_print, perm_print_high_resolution, perm_change, perm_copy,
       perm_add_notes, perm_fill_forms, perm_accessibility, perm_assemble, has_javascript, form_type
FROM pdf_info('test/data/restricted_permissions.pdf', password := 'reader');
----
true	true	false	false	false	false	false	true	false	false	acro

# Poppler's ID strings are encoded values; presence and projected identity matter.
query I
SELECT permanent_id IS NOT NULL AND update_id IS NOT NULL
FROM pdf_info('test/data/restricted_permissions.pdf', password := 'reader');
----
true

statement error
SELECT file FROM pdf_info('test/data/restricted_permissions.pdf');
----

query I
SELECT len(coalesce(list(file), []))
FROM pdf_info('test/data/restricted_permissions.pdf', ignore_errors := true);
----
0

query I
WITH projected AS (
  SELECT file, file AS projected_file FROM pdf_info('test/data/restricted_permissions.pdf', password := 'reader')
  UNION ALL SELECT file, file AS projected_file FROM pdf_info('test/data/pdfa.pdf')
  UNION ALL SELECT file, file AS projected_file FROM pdf_info('__TEST_DIR__/projection_metadata.pdf')
)
SELECT bool_and(p.projected_file IS NOT DISTINCT FROM r.file)
FROM projected p JOIN info_reference r ON p.file = r.file;
----
true

